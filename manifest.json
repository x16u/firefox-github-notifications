{
  "manifest_version": 3,
  "name": "GitHub Notifications",
  "version": "0.1.0",
  "description": "shows GitHub notifications in the browser toolbar and sends desktop notifications when new notifications arrive",
  "icons": {
    "48": "icons/bell-ring.svg",
    "96": "icons/bell-ring.svg",
    "128": "icons/bell-ring.svg"
  },

  "permissions": [
    "storage",
    "alarms",
    "notifications",
    "tabs",
    "cookies",
    "contextualIdentities"
  ],

  "host_permissions": ["*://github.com/*"],

  "background": {
    "scripts": ["src/background.js"],
    "type": "module"
  },

  "action": {
    "default_title": "GitHub Notifications",
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "48": "icons/bell-ring.svg",
      "96": "icons/bell-ring.svg"
    }
  },

  "options_ui": {
    "page": "src/options/options.html",
    "open_in_tab": false
  },

  "browser_specific_settings": {
    "gecko": {
      "id": "github-notifications@16u.dev",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["authenticationInfo"]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  }
}
